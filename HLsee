<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>⬡ Hyperliquid Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&family=Noto+Kufi+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   TOKENS
══════════════════════════════════════════ */
:root {
  --bg:       #060a0f;
  --bg2:      #0a1018;
  --bg3:      #0e1520;
  --surface:  #111926;
  --surface2: #162032;
  --border:   #1c2d42;
  --border2:  #243650;
  --green:    #00e5a0;
  --green2:   #00b87a;
  --red:      #ff3d6e;
  --red2:     #cc2050;
  --blue:     #38bdf8;
  --yellow:   #fbbf24;
  --purple:   #a78bfa;
  --orange:   #fb923c;
  --cyan:     #22d3ee;
  --dim:      #3a5570;
  --muted:    #536d85;
  --text:     #cce0f0;
  --text2:    #8aa8c0;
  --mono:     'JetBrains Mono', monospace;
  --ar:       'Noto Kufi Arabic', sans-serif;
  --sans:     'Space Grotesk', sans-serif;
  --r:        12px;
  --r2:       16px;
  --r3:       20px;
  --glow-g:   0 0 20px rgba(0,229,160,0.15);
  --glow-b:   0 0 20px rgba(56,189,248,0.15);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--ar);
  min-height:100vh;
  overflow-x:hidden;
}
/* Grid BG texture */
body::before{
  content:'';position:fixed;inset:0;
  background-image:
    linear-gradient(rgba(56,189,248,0.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(56,189,248,0.025) 1px,transparent 1px);
  background-size:48px 48px;
  pointer-events:none;z-index:0;
}
body > *{position:relative;z-index:1}

/* ══════════════════════════════════════════
   LIVE PRICES TICKER
══════════════════════════════════════════ */
.ticker-wrap{
  background:rgba(6,10,15,0.95);
  border-bottom:1px solid var(--border);
  overflow:hidden;height:38px;
  backdrop-filter:blur(8px);
  position:sticky;top:0;z-index:100;
}
.ticker-inner{
  display:flex;align-items:center;
  height:100%;gap:0;
  animation:tickerScroll 40s linear infinite;
  width:max-content;
}
@keyframes tickerScroll{
  0%{transform:translateX(0)}
  100%{transform:translateX(-50%)}
}
.ticker-item{
  display:flex;align-items:center;gap:8px;
  padding:0 24px;
  border-right:1px solid var(--border);
  height:100%;white-space:nowrap;
}
.ticker-name{font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:1.5px}
.ticker-price{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--text)}
.ticker-chg{font-family:var(--mono);font-size:9px}
.up{color:var(--green)}.dn{color:var(--red)}.neu{color:var(--muted)}

/* ══════════════════════════════════════════
   MAIN LAYOUT
══════════════════════════════════════════ */
.wrap{max-width:900px;margin:0 auto;padding:28px 16px 60px}

/* ══════════════════════════════════════════
   HEADER
══════════════════════════════════════════ */
.hdr{
  display:flex;align-items:flex-start;justify-content:space-between;
  margin-bottom:32px;gap:16px;flex-wrap:wrap;
}
.hdr-brand{display:flex;align-items:center;gap:12px}
.hdr-hex{
  width:44px;height:44px;
  background:linear-gradient(135deg,var(--green2),var(--cyan));
  clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:14px;font-weight:700;color:#000;
  flex-shrink:0;
}
.hdr-text h1{
  font-family:var(--mono);font-size:16px;font-weight:600;
  color:var(--green);letter-spacing:3px;text-transform:uppercase;
}
.hdr-text p{font-size:11px;color:var(--muted);margin-top:2px;font-family:var(--mono)}

/* Clock */
.clock-box{
  display:flex;flex-direction:column;align-items:flex-end;gap:4px;
}
.clock-date{
  font-family:var(--mono);font-size:11px;color:var(--muted);
  background:var(--surface);border:1px solid var(--border);
  border-radius:6px;padding:4px 10px;letter-spacing:.5px;
}
.clock-time{
  font-family:var(--mono);font-size:18px;font-weight:600;color:var(--cyan);
  background:var(--surface);border:1px solid var(--border2);
  border-radius:6px;padding:4px 12px;letter-spacing:3px;
  text-shadow:0 0 12px rgba(34,211,238,0.4);
}

/* ══════════════════════════════════════════
   MARKET PRICES GRID
══════════════════════════════════════════ */
.mkt-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;margin-bottom:24px;
}
.mkt-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--r2);
  padding:16px 14px;
  transition:border-color .3s,transform .2s,box-shadow .3s;
  position:relative;overflow:hidden;cursor:default;
}
.mkt-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(0,229,160,0.04),transparent 60%);
  opacity:0;transition:opacity .3s;
}
.mkt-card:hover{transform:translateY(-2px);border-color:var(--border2);box-shadow:var(--glow-g)}
.mkt-card:hover::before{opacity:1}
.mkt-icon{font-size:18px;margin-bottom:8px;display:block}
.mkt-sym{font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:1.5px;margin-bottom:4px;text-transform:uppercase}
.mkt-name{font-size:10px;color:var(--text2);margin-bottom:8px}
.mkt-price{font-family:var(--mono);font-size:15px;font-weight:600;color:var(--text);margin-bottom:4px;transition:color .3s}
.mkt-chg{font-family:var(--mono);font-size:10px;font-weight:600}
.mkt-dot{
  width:6px;height:6px;border-radius:50%;background:var(--green);
  position:absolute;top:12px;left:12px;
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}

/* ══════════════════════════════════════════
   SEARCH
══════════════════════════════════════════ */
.srch-wrap{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r2);padding:20px;
  margin-bottom:20px;
}
.srch-label{font-size:10px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;font-family:var(--mono);margin-bottom:10px;display:block}
.srch{display:flex;gap:8px}
.srch input{
  flex:1;background:var(--bg3);border:1px solid var(--border);
  border-radius:var(--r);padding:12px 16px;color:var(--text);
  font-family:var(--mono);font-size:12px;outline:none;
  transition:border-color .2s,box-shadow .2s;text-align:right;
  direction:ltr;
}
.srch input:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(0,229,160,0.08)}
.srch input::placeholder{color:var(--dim);direction:rtl}
.srch-btn{
  background:linear-gradient(135deg,var(--green2),var(--green));
  color:#000;border:none;border-radius:var(--r);
  padding:12px 24px;font-family:var(--ar);font-weight:700;
  font-size:13px;cursor:pointer;white-space:nowrap;
  transition:opacity .2s,transform .15s,box-shadow .2s;
  box-shadow:0 4px 12px rgba(0,229,160,0.25);
}
.srch-btn:hover{opacity:.9;transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,229,160,0.35)}
.srch-btn:active{transform:translateY(0)}

.alias-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.alias-chip{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:20px;padding:5px 14px;font-size:11px;
  color:var(--muted);cursor:pointer;font-family:var(--ar);
  transition:all .2s;
}
.alias-chip:hover{border-color:var(--green);color:var(--green);background:rgba(0,229,160,0.06)}

/* ══════════════════════════════════════════
   STATUS BAR
══════════════════════════════════════════ */
.status-row{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;min-height:28px;
}
.wlt-tag{
  display:none;align-items:center;gap:8px;
  font-family:var(--mono);font-size:11px;
}
.wlt-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
.wlt-addr{color:var(--blue)}
.timer-txt{font-family:var(--mono);font-size:10px;color:var(--muted)}
.timer-txt .cd{color:var(--yellow);font-weight:600}

#loading{
  display:none;align-items:center;justify-content:center;gap:10px;
  padding:20px;color:var(--muted);font-family:var(--mono);font-size:12px;
}
.spin{
  width:16px;height:16px;border:2px solid var(--border2);
  border-top-color:var(--green);border-radius:50%;
  animation:spin .7s linear infinite;flex-shrink:0;
}
@keyframes spin{to{transform:rotate(360deg)}}
.err{
  background:rgba(255,61,110,0.08);border:1px solid rgba(255,61,110,0.2);
  border-radius:var(--r);padding:12px 16px;color:var(--red);
  font-size:12px;display:none;margin-bottom:16px;font-family:var(--mono);
}

/* ══════════════════════════════════════════
   BALANCE HERO CARD
══════════════════════════════════════════ */
.bal-card{
  background:linear-gradient(135deg,#0c1c2e,#091520);
  border:1px solid var(--border2);border-radius:var(--r3);
  padding:28px;margin-bottom:18px;display:none;
  position:relative;overflow:hidden;
}
.bal-card::after{
  content:'';position:absolute;top:-60px;right:-60px;
  width:240px;height:240px;
  background:radial-gradient(circle,rgba(0,229,160,0.08),transparent 70%);
  pointer-events:none;
}
.bal-card::before{
  content:'';position:absolute;bottom:-40px;left:-40px;
  width:180px;height:180px;
  background:radial-gradient(circle,rgba(56,189,248,0.06),transparent 70%);
  pointer-events:none;
}
.bal-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:12px;flex-wrap:wrap}
.bal-main{}
.bal-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:2px;font-family:var(--mono);margin-bottom:8px}
.bal-total{font-family:var(--mono);font-size:38px;font-weight:600;color:var(--green);line-height:1;transition:color .3s}
.bal-total.flash{color:#fff}
.bal-currency{font-size:12px;color:var(--muted);margin-top:4px;font-family:var(--mono)}
.bal-sides{display:flex;flex-direction:column;gap:6px;align-items:flex-end}
.bal-sub{font-family:var(--mono);font-size:12px}
.bal-sub .lbl2{color:var(--muted);font-size:10px;letter-spacing:1px}
hr.hdiv{border:none;border-top:1px solid var(--border);margin:16px 0}
.bal-row{display:flex;gap:20px;flex-wrap:wrap}
.bi{flex:1;min-width:100px}
.bi-lbl{font-size:10px;color:var(--muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.8px;font-family:var(--mono)}
.bi-val{font-family:var(--mono);font-size:14px;font-weight:600}
.g{color:var(--green)}.r{color:var(--red)}.b{color:var(--blue)}.y{color:var(--yellow)}.p{color:var(--purple)}.o{color:var(--orange)}.c{color:var(--cyan)}

/* ══════════════════════════════════════════
   KPI
══════════════════════════════════════════ */
.kpi-row{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));
  gap:10px;margin-bottom:18px;
}
.kpi{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r2);padding:16px;text-align:center;
  transition:border-color .2s,transform .2s;
}
.kpi:hover{transform:translateY(-2px);border-color:var(--border2)}
.kpi-lbl{font-size:9px;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:1.2px;font-family:var(--mono)}
.kpi-val{font-family:var(--mono);font-size:18px;font-weight:600}
.kpi-sub{font-size:10px;color:var(--muted);margin-top:3px;font-family:var(--mono)}
.bar-w{height:3px;background:var(--border);border-radius:2px;margin-top:7px}
.bar-f{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--green),var(--cyan));transition:width 1s ease}

/* ══════════════════════════════════════════
   PNL CALENDAR
══════════════════════════════════════════ */
.cal-sec{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r2);margin-bottom:18px;overflow:hidden;
  display:none;
}
.cal-hd{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 18px;border-bottom:1px solid var(--border);
}
.cal-hd-left{display:flex;align-items:center;gap:10px}
.cal-title{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text)}
.cal-month-nav{display:flex;align-items:center;gap:8px}
.cal-nav-btn{
  background:var(--bg3);border:1px solid var(--border);border-radius:6px;
  width:26px;height:26px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--muted);font-size:12px;transition:all .15s;
}
.cal-nav-btn:hover{border-color:var(--green);color:var(--green)}
.cal-month-lbl{font-family:var(--mono);font-size:12px;color:var(--text);min-width:90px;text-align:center}
.cal-summary{font-family:var(--mono);font-size:11px}

.cal-grid{padding:14px 12px}
.cal-dow{
  display:grid;grid-template-columns:repeat(7,1fr);
  gap:4px;margin-bottom:6px;
}
.cal-dow span{
  text-align:center;font-family:var(--mono);font-size:9px;
  color:var(--dim);letter-spacing:1px;padding:4px 0;
}
.cal-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal-day{
  aspect-ratio:1;border-radius:8px;padding:4px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  cursor:default;transition:transform .15s,box-shadow .15s;
  border:1px solid transparent;position:relative;overflow:hidden;
  min-height:48px;
}
.cal-day:hover{transform:scale(1.04);z-index:2}
.cal-day.empty{background:transparent;border:none;cursor:default}
.cal-day.no-data{background:var(--bg3);border-color:var(--border)}
.cal-day.pnl-pos{
  background:rgba(0,229,160,0.10);
  border-color:rgba(0,229,160,0.25);
}
.cal-day.pnl-pos:hover{box-shadow:0 0 12px rgba(0,229,160,0.2)}
.cal-day.pnl-neg{
  background:rgba(255,61,110,0.10);
  border-color:rgba(255,61,110,0.25);
}
.cal-day.pnl-neg:hover{box-shadow:0 0 12px rgba(255,61,110,0.2)}
.cal-day.today{box-shadow:0 0 0 1.5px var(--cyan) inset}
.cal-dn{font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:2px;font-weight:500}
.cal-pnl{font-family:var(--mono);font-size:9px;font-weight:700;line-height:1.2;text-align:center}
.cal-day.pnl-pos .cal-pnl{color:var(--green)}
.cal-day.pnl-neg .cal-pnl{color:var(--red)}
.cal-day.no-data .cal-pnl{color:var(--dim)}

/* ══════════════════════════════════════════
   SECTION CARD
══════════════════════════════════════════ */
.sec{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r2);margin-bottom:18px;overflow:hidden;
}
.sec-hd{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 18px;border-bottom:1px solid var(--border);
  background:rgba(255,255,255,0.01);
}
.sec-title{font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--text2)}
.badge{
  font-family:var(--mono);font-size:10px;padding:3px 9px;
  border-radius:12px;border:1px solid var(--border2);color:var(--muted);
}
.tbl-w{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{
  font-family:var(--mono);font-size:9px;color:var(--dim);
  padding:9px 14px;text-align:right;font-weight:500;
  border-bottom:1px solid var(--border);letter-spacing:1.2px;
  text-transform:uppercase;white-space:nowrap;
}
td{
  padding:10px 14px;font-family:var(--mono);font-size:11px;
  border-bottom:1px solid rgba(28,45,66,0.5);white-space:nowrap;
  color:var(--text);
}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(56,189,248,0.03)}
.tag{
  display:inline-block;font-size:9px;padding:3px 8px;
  border-radius:4px;font-family:var(--mono);font-weight:700;
  letter-spacing:.5px;
}
.tag-buy{background:rgba(0,229,160,0.12);color:var(--green)}
.tag-sell{background:rgba(255,61,110,0.12);color:var(--red)}
.tag-maker{background:rgba(167,139,250,0.12);color:var(--purple)}
.tag-taker{background:rgba(56,189,248,0.12);color:var(--blue)}
.empty{text-align:center;padding:32px;color:var(--dim);font-size:12px;font-family:var(--ar)}

/* ══════════════════════════════════════════
   FEE NOTE
══════════════════════════════════════════ */
.fee-note{
  background:rgba(167,139,250,0.05);border:1px solid rgba(167,139,250,0.15);
  border-radius:var(--r);padding:10px 14px;font-size:11px;
  color:var(--muted);display:none;font-family:var(--mono);line-height:1.8;
  margin-bottom:18px;
}
.fee-note span{color:var(--purple)}

/* ══════════════════════════════════════════
   TX SECTION
══════════════════════════════════════════ */
.tx-sec{display:none;margin-bottom:18px}
.tx-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px}
.tx-stat{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r);padding:12px;
}
.ts-lbl{font-size:9px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;font-family:var(--mono)}
.ts-val{font-family:var(--mono);font-size:14px;font-weight:600}
.ts-sub{font-size:10px;color:var(--muted);margin-top:1px;font-family:var(--mono)}
.ts-in{color:var(--green)}.ts-out{color:var(--red)}.ts-net{color:var(--blue)}.ts-cnt{color:var(--yellow)}

.tx-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r2);overflow:hidden;
}
.tx-hd{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px;border-bottom:1px solid var(--border);
  background:rgba(255,255,255,0.01);flex-wrap:wrap;gap:8px;
}
.tx-tabs{display:flex;gap:0;flex-wrap:wrap}
.tx-tab{
  padding:7px 12px;font-size:11px;font-weight:600;cursor:pointer;
  border:none;background:transparent;color:var(--muted);
  border-bottom:2px solid transparent;margin-bottom:-1px;
  transition:color .15s,border-color .15s;
  display:flex;align-items:center;gap:5px;font-family:var(--ar);
}
.tx-tab:hover{color:var(--text)}
.tx-tab.active{color:var(--blue);border-bottom-color:var(--blue)}
.tx-tab.active.t-in{color:var(--green);border-bottom-color:var(--green)}
.tx-tab.active.t-out{color:var(--red);border-bottom-color:var(--red)}
.tx-cnt{
  font-size:9px;font-family:var(--mono);background:var(--bg3);
  color:var(--muted);padding:2px 6px;border-radius:8px;
}
.tx-tab.active .tx-cnt{background:rgba(56,189,248,0.1);color:var(--blue)}
.tx-tab.active.t-in .tx-cnt{background:rgba(0,229,160,0.1);color:var(--green)}
.tx-tab.active.t-out .tx-cnt{background:rgba(255,61,110,0.1);color:var(--red)}
.tx-info{font-family:var(--mono);font-size:10px;color:var(--muted)}
.tx-tbl-w{overflow-x:auto}
.tx-tbl{width:100%;border-collapse:collapse;min-width:560px}
.tx-tbl th{
  font-size:9px;color:var(--dim);padding:9px 12px;text-align:right;
  font-weight:500;border-bottom:1px solid var(--border);
  letter-spacing:1px;text-transform:uppercase;white-space:nowrap;
  font-family:var(--mono);
}
.tx-tbl td{
  padding:9px 12px;font-family:var(--mono);font-size:11px;
  border-bottom:1px solid rgba(28,45,66,0.4);white-space:nowrap;
  vertical-align:middle;color:var(--text);
}
.tx-tbl tr:last-child td{border-bottom:none}
.tx-tbl tr:hover td{background:rgba(56,189,248,0.03)}
.tx-chip{
