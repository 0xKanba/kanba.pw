<script>
/* ════════════════════════════════════════════════════════════════
   CONFIG
════════════════════════════════════════════════════════════════ */
const API = "https://api.hyperliquid.xyz/info";
const ALIASES = {
  "ياسر":  "0x6cc7ea5913c3002d53938b8e93da8425ab0bbafa",
  "يونس":  "0x751d8d19760907d5d68c5ea758d1984282a0b39d",
  "علاوي": "0x8fb06d076cb42b3480a19bab8f1d7d4170839e0f",
  "كانبا": "0x0640F5Bfc50AC53eC68C435a60cB0ffF5C555FAD"
};

const XYZ_ASSETS = [
  { id:'gold',   coin:'xyz:GOLD',   sym:'GOLD'   },
  { id:'silver', coin:'xyz:SILVER', sym:'SILVER' },
  { id:'oil',    coin:'xyz:CL',    sym:'oil'    },
  { id:'xyz',    coin:'xyz:XYZ100', sym:'XYZ100' },
];

const HL_ASSETS = ['BTC','ETH','SOL'];

let cdTimer = null, currentAddress = '';
const TX_PER = 25;
let txAll = [], txFiltered = [], txTab = 'all', txPage = 0;

// Calendar state
let calYear, calMonth, calPnlData = {};

/* ════════════════════════════════════════════════════════════════
   CLOCK
════════════════════════════════════════════════════════════════ */
function startClock() {
  const updateClock = () => {
    const now = new Date();
    // Date: "3 مارس 2025"
    const dateStr = now.toLocaleDateString('en-uk', { day:'numeric', month:'long', year:'numeric' });
    // Time: "22:11:33"
    const timeStr = now.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    document.getElementById('clockDate').textContent = dateStr;
    document.getElementById('clockTime').textContent = timeStr;
  };
  updateClock();
  setInterval(updateClock, 1000);
}

/* ════════════════════════════════════════════════════════════════
   LIVE MARKET PRICES
════════════════════════════════════════════════════════════════ */
async function fetchMarketPrices() {
  try {
    // XYZ assets via l2Book
    const xyzRes = await Promise.all(XYZ_ASSETS.map(a =>
      fetch(API, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ type:'l2Book', coin: a.coin })
      }).then(r => r.json())
    ));

    // HL perps mids + meta for 24h change
    const [midsR, metaR] = await Promise.all([
      fetch(API, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'allMids'})}),
      fetch(API, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'metaAndAssetCtxs'})})
    ]);
    const mids = await midsR.json();
    const meta = await metaR.json();

    const prevMap = {};
    meta[0].universe.forEach((u,i) => { prevMap[u.name] = parseFloat(meta[1][i]?.prevDayPx || 0); });

    // Update XYZ price cards
    XYZ_ASSETS.forEach((a, i) => {
      const lb = xyzRes[i];
      if (lb.levels?.[0]?.[0] && lb.levels?.[1]?.[0]) {
        const bid   = parseFloat(lb.levels[0][0].px);
        const ask   = parseFloat(lb.levels[1][0].px);
        const price = (bid + ask) / 2;
        setMktCard(a.id, price, null);
      }
    });

    // Update HL ticker prices
    HL_ASSETS.forEach(sym => {
      const price = parseFloat(mids[sym]);
      const prev  = prevMap[sym] || 0;
      const chg   = prev > 0 ? (price - prev) / prev * 100 : null;
      const key   = sym.toLowerCase();
      setTickerItem(key, price, chg);
      setTickerItem(key+'2', price, chg);
    });

    // XYZ ticker (we need candleSnapshot for 24h chg)
    // Use l2Book price and last candle for change
    for (const [i, a] of XYZ_ASSETS.entries()) {
      try {
        const now = Date.now();
        const cr = await fetch(API, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ type:'candleSnapshot', req:{ coin:a.coin, interval:'1h', startTime: now - 86400000, endTime: now }})
        });
        const candles = await cr.json();
        if (Array.isArray(candles) && candles.length >= 2) {
          const firstOpen = parseFloat(candles[0].o);
          const lastClose = parseFloat(candles[candles.length-1].c);
          const chg = firstOpen > 0 ? (lastClose - firstOpen) / firstOpen * 100 : null;
          // Re-read price from card
          const priceEl = document.getElementById('p-' + a.id);
          const priceVal = priceEl ? parseFloat(priceEl.dataset.raw || 0) : 0;
          setChgDisplay(a.id, chg);
          setTickerItem(a.id, priceVal, chg);
          setTickerItem(a.id+'2', priceVal, chg);
        }
      } catch(e) {}
    }

  } catch(e) { console.error('market:', e.message); }
}

function setMktCard(id, price, chg) {
  const el = document.getElementById('p-' + id);
  if (!el) return;
  el.dataset.raw = price;
  el.textContent = '$' + fmtP(price);
  setChgDisplay(id, chg);
  setTickerItem(id, price, chg);
  setTickerItem(id+'2', price, chg);
}

function setChgDisplay(id, chg) {
  const el = document.getElementById('c-' + id);
  if (!el || chg === null || chg === undefined) return;
  const sign = chg >= 0 ? '+' : '';
  el.textContent = sign + chg.toFixed(2) + '%';
  el.className = 'mkt-chg ' + (chg >= 0 ? 'up' : 'dn');
  // Update card price color
  const pe = document.getElementById('p-' + id);
  if (pe) pe.style.color = chg >= 0 ? 'var(--green)' : 'var(--red)';
}

function setTickerItem(id, price, chg) {
  const pe = document.getElementById('tk-' + id);
  const ce = document.getElementById('tkc-' + id);
  if (pe && price > 0) pe.textContent = '$' + fmtP(price);
  if (ce && chg !== null && chg !== undefined) {
    const sign = chg >= 0 ? '+' : '';
    ce.textContent = sign + chg.toFixed(2) + '%';
    ce.className = 'ticker-chg ' + (chg >= 0 ? 'up' : 'dn');
  }
}

function fmtP(v) {
  if (!v || isNaN(v)) return '—';
  if (v >= 1000) return v.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  if (v >= 100)  return v.toFixed(2);
  if (v >= 1)    return v.toFixed(3);
  return v.toFixed(5);
}

/* ════════════════════════════════════════════════════════════════
   PNL CALENDAR
════════════════════════════════════════════════════════════════ */
function buildCalendar(fills) {
  // Build daily PnL map from fills
  calPnlData = {};
  fills.forEach(f => {
    const pnl = parseFloat(f.closedPnl || 0);
    if (!pnl) return;
    const d = new Date(f.time);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    calPnlData[key] = (calPnlData[key] || 0) + pnl;
  });

  const now = new Date();
  calYear  = now.getFullYear();
  calMonth = now.getMonth();
  renderCalendar();
}

function calNav(dir) {
  calMonth += dir;
  if (calMonth > 11) { calMonth = 0; calYear++; }
  if (calMonth < 0)  { calMonth = 11; calYear--; }
  renderCalendar();
}

function renderCalendar() {
  const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
  document.getElementById('calMonthLbl').textContent = `${monthNames[calMonth]} ${calYear}`;

  const firstDay = new Date(calYear, calMonth, 1).getDay(); // 0=Sun
  const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
  const today = new Date();

  // Monthly summary
  let monthTotal = 0;
  for (let d = 1; d <= daysInMonth; d++) {
    const key = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    if (calPnlData[key]) monthTotal += calPnlData[key];
  }
  const sumEl = document.getElementById('calSummary');
  if (monthTotal !== 0) {
    sumEl.innerHTML = `<span style="color:${monthTotal>=0?'var(--green)':'var(--red)'}">${monthTotal>=0?'+':''}${fmt(monthTotal,2)} $</span>`;
  } else {
    sumEl.textContent = '';
  }

  // Build grid
  let html = '';
  // empty cells before first day
  for (let i = 0; i < firstDay; i++) html += `<div class="cal-day empty"></div>`;

  for (let d = 1; d <= daysInMonth; d++) {
    const key = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const pnl = calPnlData[key];
    const isToday = (d===today.getDate() && calMonth===today.getMonth() && calYear===today.getFullYear());
    let cls = 'cal-day ';
    let pnlHtml = '';

    if (pnl !== undefined && pnl !== 0) {
      cls += pnl >= 0 ? 'pnl-pos' : 'pnl-neg';
      const sign = pnl >= 0 ? '+' : '';
      // Shorten large numbers
      let pnlStr;
      const abs = Math.abs(pnl);
      if (abs >= 10000) pnlStr = sign + (pnl/1000).toFixed(1) + 'k';
      else if (abs >= 1000) pnlStr = sign + pnl.toFixed(0);
      else pnlStr = sign + pnl.toFixed(1);
      pnlHtml = `<div class="cal-pnl">${pnlStr}</div>`;
    } else {
      cls += 'no-data';
      pnlHtml = '';
    }
    if (isToday) cls += ' today';

    const title = pnl !== undefined ? `${key}: ${pnl>=0?'+':''}${fmt(pnl,2)} $` : key;
    html += `<div class="${cls}" title="${title}" style="animation:fadeUp .2s ${((firstDay+d-1)%7)*.03}s both">
      <div class="cal-dn">${d}</div>${pnlHtml}
    </div>`;
  }
  document.getElementById('calDays').innerHTML = html;
}

/* ════════════════════════════════════════════════════════════════
   MAIN ANALYZE
════════════════════════════════════════════════════════════════ */
async function post(b) {
  const r = await fetch(API, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}

function quickLoad(name) {
  document.getElementById('addrInput').value = name;
  analyze();
}

async function analyze(isRef=false) {
  const raw  = isRef ? currentAddress : document.getElementById('addrInput').value.trim();
  const addr = ALIASES[raw] || raw;
  if (!addr || addr.length < 10) { showErr('أدخل عنوان صحيح'); return; }
  currentAddress = addr;

  if (!isRef) {
    ['posSec','histSec','foot','kpiRow','calSec'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    document.getElementById('balCard').style.display = 'none';
    document.getElementById('feeNote').style.display = 'none';
    document.getElementById('txSec').style.display   = 'none';
    showErr('');
  }

  document.getElementById('loading').style.display = 'flex';

  try {
    const [perp, spot, fills, mids, txData] = await Promise.all([
      post({ type:'clearinghouseState',           user:addr }),
      post({ type:'spotClearinghouseState',        user:addr }),
      post({ type:'userFills',                     user:addr }),
      post({ type:'allMids' }),
      post({ type:'userNonFundingLedgerUpdates',   user:addr, startTime:0 })
    ]);

    const wltTag = document.getElementById('wltTag');
    wltTag.style.display = 'flex';
    document.getElementById('wltSpan').textContent = addr.slice(0,6) + '...' + addr.slice(-4);

    renderBal(perp, spot, fills);
    renderKPI(fills);
    renderPos(perp, mids);
    renderHist(fills);
    renderTx(txData, addr);
    buildCalendar(fills);

    ['posSec','histSec','foot','feeNote'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = '';
    });
    document.getElementById('kpiRow').style.display = 'grid';
    document.getElementById('txSec').style.display  = 'block';
    document.getElementById('calSec').style.display = 'block';
    document.getElementById('updTime').textContent  = new Date().toLocaleTimeString('ar-EG');
    showErr('');

    if (!isRef) startCD();
    else {
      const tb = document.getElementById('totalBal');
      tb.classList.add('flash');
      setTimeout(() => tb.classList.remove('flash'), 350);
    }
  } catch(e) {
    showErr('خطأ: ' + e.message);
  } finally {
    document.getElementById('loading').style.display = 'none';
  }
}

function startCD() {
  clearInterval(cdTimer);
  let cd = 30;
  const div = document.getElementById('timerDiv');
  div.style.display = 'block';
  document.getElementById('countdown').textContent = cd;
  cdTimer = setInterval(() => {
    cd--;
    document.getElementById('countdown').textContent = cd;
    if (cd <= 0) { cd = 30; analyze(true); }
  }, 1000);
}

/* ── BALANCE ── */
function renderBal(perp, spot, fills) {
  const s     = perp.marginSummary;
  const perpV = parseFloat(s.accountValue);
  const mU    = parseFloat(s.totalMarginUsed);
  const mF    = parseFloat(s.totalRawUsd);
  let spotV   = 0;
  (spot.balances||[]).forEach(b => spotV += parseFloat(b.total||0));
  const total    = perpV + spotV;
  const feeTotal = fills.reduce((a,f) => a + parseFloat(f.fee||0), 0);
  const active   = (perp.assetPositions||[]).filter(p => parseFloat(p.position.szi) !== 0).length;

  document.getElementById('balCard').style.display = 'block';
  animNum('totalBal', total, 3);
  animNum('perpBal', perpV, 3);
  animNum('spotBal', spotV, 3);
  animNum('marginUsed', mU, 3);
  animNum('marginFree', mF, 3);
  document.getElementById('totalFees').textContent = fmt(feeTotal) + ' $';
  document.getElementById('openCount').textContent = active;
}

/* ── KPI ── */
function renderKPI(fills) {
  if (!fills.length) {
    document.getElementById('kpiRow').innerHTML = '<div class="kpi"><div class="kpi-lbl">صفقات</div><div class="kpi-val y">0</div></div>';
    return;
  }
  const total  = fills.length;
  const pnlAll = fills.reduce((a,f) => a + parseFloat(f.closedPnl||0), 0);
  const feeAll = fills.reduce((a,f) => a + parseFloat(f.fee||0), 0);
  const net    = pnlAll - feeAll;
  const wins   = fills.filter(f => parseFloat(f.closedPnl||0) > 0).length;
  const wr     = (wins/total*100).toFixed(1);
  const makers = fills.filter(f => f.crossed===false||(f.crossed===undefined&&parseFloat(f.fee||0)<=0)).length;
  const mkPct  = Math.round(makers/total*100);

  document.getElementById('kpiRow').innerHTML = `
    <div class="kpi"><div class="kpi-lbl">صافي الربح</div><div class="kpi-val ${pc(net)}">${net>=0?'+':''}${fmt(net)}</div><div class="kpi-sub">USDC</div></div>
    <div class="kpi"><div class="kpi-lbl">نسبة الربح</div><div class="kpi-val ${parseFloat(wr)>=50?'g':'r'}">${wr}%</div><div class="bar-w"><div class="bar-f" style="width:${wr}%"></div></div></div>
    <div class="kpi"><div class="kpi-lbl">صفقات كلي</div><div class="kpi-val y">${total}</div><div class="kpi-sub">${wins} ربح / ${total-wins} خسارة</div></div>
    <div class="kpi"><div class="kpi-lbl">صانع سوق</div><div class="kpi-val p">${mkPct}%</div><div class="kpi-sub">${makers} صفقة</div></div>
    <div class="kpi"><div class="kpi-lbl">آخذ سوق</div><div class="kpi-val b">${100-mkPct}%</div><div class="kpi-sub">${total-makers} صفقة</div></div>
    <div class="kpi"><div class="kpi-lbl">إجمالي رسوم</div><div class="kpi-val r">${fmt(feeAll)}</div><div class="kpi-sub">USDC</div></div>`;
}

/* ── POSITIONS ── */
function renderPos(perp, mids) {
  const active = (perp.assetPositions||[]).filter(p => parseFloat(p.position.szi) !== 0);
  document.getElementById('posBadge').textContent = active.length + ' مركز';
  if (!active.length) {
    document.getElementById('posTbody').innerHTML = '<tr><td colspan="8"><div class="empty">لا توجد مراكز مفتوحة</div></td></tr>';
    return;
  }
  document.getElementById('posTbody').innerHTML = active.map(p => {
    const pos  = p.position;
    const size = parseFloat(pos.szi);
    const entry= parseFloat(pos.entryPx);
    const pnl  = parseFloat(pos.unrealizedPnl);
    const now  = parseFloat(mids[pos.coin]||0);
    const pnlPct = entry && now ? ((now-entry)/entry*100*(size>0?1:-1)).toFixed(2) : '—';
    const cl   = pc(pnl);
    return `<tr style="animation:fadeUp .25s both">
      <td style="font-weight:600">${pos.coin}</td>
      <td><span class="tag ${size>0?'tag-buy':'tag-sell'}">${size>0?'شراء':'بيع'}</span></td>
      <td>${fmt(Math.abs(size),4)}</td>
      <td>${fmt(entry)}</td>
      <td class="b">${now?fmt(now):'—'}</td>
      <td class="${cl}">${pnl>=0?'+':''}${fmt(pnl)} $</td>
      <td class="${cl}">${pnlPct!=='—'?(parseFloat(pnlPct)>=0?'+':'')+pnlPct+'%':'—'}</td>
      <td class="y">${pos.leverage.value}x</td>
    </tr>`;
  }).join('');
}

/* ── FILLS ── */
function renderHist(fills) {
  document.getElementById('histBadge').textContent = fills.length + ' صفقة';
  if (!fills.length) {
    document.getElementById('histTbody').innerHTML = '<tr><td colspan="9"><div class="empty">لا توجد صفقات</div></td></tr>';
    return;
  }
  const sorted = [...fills].sort((a,b) => b.time - a.time);
  document.getElementById('histTbody').innerHTML = sorted.map(f => {
    const pnl      = parseFloat(f.closedPnl||0);
    const fee      = parseFloat(f.fee||0);
    const notional = parseFloat(f.sz||0) * parseFloat(f.px||0);
    const feePct   = notional > 0 ? (Math.abs(fee)/notional*100).toFixed(4) : '—';
    const ot  = orderType(f);
    const cl  = pc(pnl);
    const fc  = fee < 0 ? 'g' : '';
    return `<tr style="animation:fadeUp .2s both">
      <td style="color:var(--muted)">${fmtT(f.time)}</td>
      <td style="font-weight:600">${f.coin}</td>
      <td><span class="tag ${f.side==='B'?'tag-buy':'tag-sell'}">${f.side==='B'?'شراء':'بيع'}</span></td>
      <td><span class="tag ${ot.cls}">${ot.label}</span></td>
      <td>${fmt(parseFloat(f.px))}</td>
      <td>${fmt(parseFloat(f.sz),4)}</td>
      <td class="${cl}">${pnl!==0?(pnl>0?'+':'')+fmt(pnl)+' $':'—'}</td>
      <td class="${fc}">${fee<0?'↩ '+fmt(Math.abs(fee),4):fmt(fee,4)}</td>
      <td style="color:var(--muted)">${feePct!=='—'?feePct+'%':'—'}</td>
    </tr>`;
  }).join('');
}

/* ════════════════════════════════════════════════════════════════
   TRANSACTIONS
════════════════════════════════════════════════════════════════ */
const TX_TYPE_MAP = {
  deposit:'إيداع', withdraw:'سحب', spotTransfer:'تحويل سبوت',
  internalTransfer:'داخلي', subAccountTransfer:'حساب فرعي',
  accountClassTransfer:'تصنيف', vaultDeposit:'إيداع خزينة',
  vaultWithdraw:'سحب خزينة', funding:'تمويل', liquidation:'تصفية'
};

function txClassify(tx, addr) {
  const t  = tx.delta.type;
  if (t==='deposit')     return 'in';
  if (t==='withdraw')    return 'out';
  if (t==='vaultWithdraw') return 'in';
  if (t==='vaultDeposit')  return 'out';
  if (t==='spotTransfer') {
    const usdc = parseFloat(tx.delta.usdc||0);
    return usdc > 0 ? 'in' : 'out';
  }
  return 'int';
}
function txAmt(tx) {
  const d = tx.delta;
  return Math.abs(parseFloat(d.usdc||d.amount||d.nUsdc||0));
}
function txFrom(tx, addr) {
  const d = tx.delta;
  if (d.type==='deposit')      return d.user || addr;
  if (d.type==='spotTransfer' && d.user) return d.user;
  return addr;
}
function txTo(tx, addr) {
  const d = tx.delta;
  if (d.type==='withdraw')     return d.destination || '—';
  if (d.type==='spotTransfer' && d.destination) return d.destination;
  return addr;
}

function renderTx(raw, addr) {
  txAll = (Array.isArray(raw)?raw:[])
    .map(tx => ({...tx, _dir:txClassify(tx,addr), _amt:txAmt(tx)}))
    .sort((a,b) => b.time - a.time);

  const totIn  = txAll.filter(t=>t._dir==='in').reduce((s,t)=>s+t._amt,0);
  const totOut = txAll.filter(t=>t._dir==='out').reduce((s,t)=>s+t._amt,0);
  const net    = totIn - totOut;
  document.getElementById('txStatIn').textContent  = '+' + fmt(totIn,2);
  document.getElementById('txStatOut').textContent = '-' + fmt(totOut,2);
  const netEl = document.getElementById('txStatNet');
  netEl.textContent = (net>=0?'+':'')+fmt(net,2);
  netEl.style.color = net>=0 ? 'var(--green)' : 'var(--red)';
  document.getElementById('txStatCnt').textContent = txAll.length;

  ['all','in','out','int'].forEach(t => {
    document.getElementById('txcnt-'+t).textContent =
      t==='all' ? txAll.length :
      txAll.filter(tx=>tx._dir===t).length;
  });
  document.getElementById('txInfo').textContent = txAll.length + ' معاملة';

  txTab = 'all'; txPage = 0;
  ['all','in','out','int'].forEach(t => document.getElementById('txtab-'+t).classList.remove('active'));
  document.getElementById('txtab-all').classList.add('active');
  txApply();
}

function txSwitch(tab) {
  txTab = tab; txPage = 0;
  ['all','in','out','int'].forEach(t => document.getElementById('txtab-'+t).classList.remove('active'));
  document.getElementById('txtab-'+tab).classList.add('active');
  txApply();
}
function txApply() {
  txFiltered = txTab==='all' ? txAll : txAll.filter(t=>t._dir===txTab);
  txRenderPage();
}
function txRenderPage() {
  const start = txPage * TX_PER;
  const slice = txFiltered.slice(start, start+TX_PER);
  const tbody = document.getElementById('txTbody');
  const empty = document.getElementById('txEmpty');
  const addr  = currentAddress;

  if (!slice.length) {
    tbody.innerHTML = '';
    empty.style.display = 'block';
    document.getElementById('txPager').style.display = 'none';
    return;
  }
  empty.style.display = 'none';

  tbody.innerHTML = slice.map((tx,i) => {
    const dir     = tx._dir;
    const amt     = tx._amt;
    const from    = txFrom(tx, addr);
    const to      = txTo(tx, addr);
    const isMe    = a => a && a.toLowerCase()===addr.toLowerCase();
    const typeLbl = TX_TYPE_MAP[tx.delta.type] || tx.delta.type;
    const token   = tx.delta.token || 'USDC';
    const chipCls = dir==='in'?'tc-in':dir==='out'?'tc-out':'tc-int';
    const dirLbl  = dir==='in'?'↓ وارد':dir==='out'?'↑ صادر':'⇄ داخلي';
    const amtCls  = dir==='in'?'tx-amt-in':dir==='out'?'tx-amt-out':'tx-amt-int';
    const sign    = dir==='in'?'+':dir==='out'?'-':'';
    return `<tr style="animation:txFade .2s ${i*.025}s both">
      <td><span class="tx-chip ${chipCls}">${dirLbl}</span></td>
      <td class="${amtCls}">${sign}${fmt(amt,amt<1?4:2)}</td>
      <td style="color:var(--muted);font-size:10px">${token}</td>
      <td>${isMe(from)?'<span class="tx-you">أنت</span>':`<span class="tx-addr" onclick="navigator.clipboard?.writeText('${from}')" title="${from}">${short(from)}</span>`}</td>
      <td>${isMe(to)?'<span class="tx-you">أنت</span>':`<span class="tx-addr" onclick="navigator.clipboard?.writeText('${to}')" title="${to}">${short(to)}</span>`}</td>
      <td class="tx-time" title="${new Date(tx.time).toLocaleString('ar-EG')}">${fmtAge(tx.time)}</td>
      <td class="tx-type-lbl">${typeLbl}</td>
    </tr>`;
  }).join('');

  const total = txFiltered.length;
  const pages = Math.ceil(total/TX_PER);
  const pager = document.getElementById('txPager');
  if (pages > 1) {
    document.getElementById('txPagerInfo').textContent = `${start+1}–${Math.min(start+TX_PER,total)} من ${total}`;
    document.getElementById('txBtnPrev').disabled = txPage===0;
    document.getElementById('txBtnNext').disabled = txPage>=pages-1;
    pager.style.display = 'flex';
  } else {
    pager.style.display = 'none';
  }
}
function txPrev() { if (txPage>0){txPage--;txRenderPage();} }
function txNext() { if (txPage<Math.ceil(txFiltered.length/TX_PER)-1){txPage++;txRenderPage();} }

/* ════════════════════════════════════════════════════════════════
   UTILS
════════════════════════════════════════════════════════════════ */
function fmt(n, d=3) {
  const v = parseFloat(n);
  if (isNaN(v)) return '—';
  return v.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
}
function fmtT(ts) {
  return new Date(ts).toLocaleString('en-UK',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
}
function fmtAge(ts) {
  const d = Date.now() - ts;
  if (d < 60000)    return 'الآن';
  if (d < 3600000)  return Math.floor(d/60000) + ' د';
  if (d < 86400000) return Math.floor(d/3600000) + ' س';
  return fmtT(ts);
}
function pc(v) { return v>0?'g':v<0?'r':''; }
function short(a) { return a&&a.length>10?a.slice(0,6)+'…'+a.slice(-4):(a||'—'); }
function orderType(f) {
  if (f.crossed===true)  return {label:'سوق',cls:'tag-taker'};
  if (f.crossed===false) return {label:'طلب حد',cls:'tag-maker'};
  return parseFloat(f.fee||0)<=0
    ? {label:'طلب حد',cls:'tag-maker'}
    : {label:'سوق',cls:'tag-taker'};
}
function animNum(id, val, d=3) {
  const el = document.getElementById(id);
  if (!el) return;
  const from = parseFloat(el.dataset.v || 0);
  const to   = parseFloat(val);
  if (isNaN(to)) { el.textContent = '—'; return; }
  el.dataset.v = to;
  if (Math.abs(from-to) < 0.0001) { el.textContent = fmt(to,d); return; }
  const t0 = Date.now(), dur = 700;
  const tick = () => {
    const p = Math.min((Date.now()-t0)/dur,1);
    const e = p<.5?2*p*p:-1+(4-2*p)*p;
    el.textContent = fmt(from+(to-from)*e, d);
    if (p<1) requestAnimationFrame(tick);
    else el.textContent = fmt(to,d);
  };
  requestAnimationFrame(tick);
}
function showErr(msg) {
  const el = document.getElementById('errBox');
  el.textContent = msg;
  el.style.display = msg ? 'block' : 'none';
}

